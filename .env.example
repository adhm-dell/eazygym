# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gym_system?schema=public"

# Auth & Secrets
JWT_SECRET="gym-system-super-secret-jwt-key"

# Ports
API_PORT=4000
STAFF_PORT=3000
COACH_PORT=3001
MEMBER_PORT=3002

# Reset & Bootstrap
ALLOW_DB_RESET=false
BOOTSTRAP_GYM_NAME="اسم الجيم"
BOOTSTRAP_GYM_SLUG="my-gym"
BOOTSTRAP_TIMEZONE="Africa/Cairo"
BOOTSTRAP_ADMIN_NAME="المالك"
BOOTSTRAP_ADMIN_EMAIL="owner@yourgym.com"
BOOTSTRAP_ADMIN_PASSWORD="<at least 10 characters>"
# optional platform admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
